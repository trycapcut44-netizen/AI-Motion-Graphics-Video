# GlobalDub AI Configuration

# Server
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./storage/globaldub.db

# Google Gemini API
# Acquire your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Model Identifiers
GEMINI_TRANSCRIPTION_MODEL=gemini-2.0-flash
GEMINI_TRANSLATION_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Limits
MAX_UPLOAD_SIZE_BYTES=262144000
MAX_VIDEO_DURATION_SECONDS=600
MAX_CONCURRENT_JOBS=2

# Frontend URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
